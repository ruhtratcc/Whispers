%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0bd3546e0145d6b4a98930b0bb8dc3cf, type: 3}
  m_Name: LockpickDialogue
  m_EditorClassIdentifier: HorrorGame.Runtime::HorrorGame.LockpickDialogue
  lines:
  - id: wp_opt_lockpick_avaliar_01
    trigger: avaliar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Talvez d\xEA pra abrir sem chave."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_avaliar_02
    trigger: avaliar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Essa fechadura est\xE1 gasta."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_avaliar_03
    trigger: avaliar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Preciso olhar essa fechadura melhor.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_avaliar_04
    trigger: avaliar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Talvez eu consiga destrancar isso.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_sem_grampo_01
    trigger: sem_grampo
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Se eu tivesse um grampo...
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_sem_grampo_02
    trigger: sem_grampo
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Preciso de alguma coisa fina.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_sem_grampo_03
    trigger: sem_grampo
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "S\xF3 com a m\xE3o n\xE3o vai."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_sem_grampo_04
    trigger: sem_grampo
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Falta uma ferramenta pra isso.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_comecar_01
    trigger: comecar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Vou tentar com cuidado.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_comecar_02
    trigger: comecar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Devagar, sem for\xE7ar."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_comecar_03
    trigger: comecar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Vamos ver se eu consigo.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_comecar_04
    trigger: comecar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Preciso sentir onde prende.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_quase_01
    trigger: quase
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Quase...
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_quase_02
    trigger: quase
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Est\xE1 cedendo."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_quase_03
    trigger: quase
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Falta pouco.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_quase_04
    trigger: quase
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Acho que achei o ponto.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_travou_01
    trigger: travou
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Travou.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_travou_02
    trigger: travou
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Prendeu de novo.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_travou_03
    trigger: travou
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "N\xE3o est\xE1 girando."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_travou_04
    trigger: travou
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Melhor soltar um pouco.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_quebrou_01
    trigger: quebrou
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: O grampo quebrou.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_quebrou_02
    trigger: quebrou
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Forcei demais.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_quebrou_03
    trigger: quebrou
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Pronto. Perdi o grampo.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_quebrou_04
    trigger: quebrou
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Preciso de outro grampo.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_conseguiu_01
    trigger: conseguiu
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Destrancou.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_conseguiu_02
    trigger: conseguiu
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Consegui destrancar.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_conseguiu_03
    trigger: conseguiu
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: A fechadura cedeu.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_conseguiu_04
    trigger: conseguiu
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Foi. Consegui.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_ruido_01
    trigger: ruido
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Barulho demais.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_ruido_02
    trigger: ruido
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Mais devagar. Est\xE1 fazendo barulho."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_ruido_03
    trigger: ruido
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Preciso fazer isso sem tanta for\xE7a."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_ruido_04
    trigger: ruido
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Fez barulho demais.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_pressa_01
    trigger: pressa
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "R\xE1pido..."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_pressa_02
    trigger: pressa
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Tenho que terminar isso.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_pressa_03
    trigger: pressa
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Mais um pouco e eu paro.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_pressa_04
    trigger: pressa
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "N\xE3o posso ficar aqui a noite toda."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_calma_01
    trigger: calma
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Calma.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_calma_02
    trigger: calma
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Sem afoba\xE7\xE3o."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_calma_03
    trigger: calma
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Respira e tenta de novo.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_calma_04
    trigger: calma
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "N\xE3o adianta for\xE7ar agora."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_recomecar_01
    trigger: recomecar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "N\xE3o, de novo."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_recomecar_02
    trigger: recomecar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Vou come\xE7ar outra vez."
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_recomecar_03
    trigger: recomecar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Melhor tirar e tentar de novo.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_opt_lockpick_recomecar_04
    trigger: recomecar
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Perdi o ponto. Volta.
    priority: P3
    direction: Baixo, seco, pensando alto. Sem dramatizar o medo.
    voice: {fileID: 0}
  - id: wp_lockpick_pickup_01
    trigger: pickup
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "\xC9 o grampo da Helena."
    priority: P2
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_pickup_02
    trigger: pickup
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Isso ainda pode servir.
    priority: P2
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_pickup_03
    trigger: pickup
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Um grampo... vou levar.
    priority: P2
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_first_01
    trigger: first
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "J\xE1 fiz isso mais vezes do que devia."
    priority: P2
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_first_02
    trigger: first
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Aprendi a fazer isso no come\xE7o da carreira."
    priority: P2
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_first_03
    trigger: first
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Faz tempo que eu n\xE3o tento isso."
    priority: P2
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_empty_01
    trigger: empty
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Acabaram os grampos.
    priority: P3
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_empty_02
    trigger: empty
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Era o \xFAltimo."
    priority: P3
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_empty_03
    trigger: empty
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Vou precisar de outro grampo.
    priority: P3
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_note_01
    trigger: note
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Deixaram isso guardado aqui.
    priority: P3
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_note_02
    trigger: note
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: Vou guardar esse papel.
    priority: P3
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_note_03
    trigger: note
    character: "Jo\xE3o de Claus"
    actor: Homem1
    text: "Deixa eu ver o que \xE9 isso."
    priority: P3
    direction: "Baixo, seco, pensando alto; sem explicar a mec\xE2nica."
    voice: {fileID: 0}
  - id: wp_lockpick_helena_01
    trigger: helena
    character: "Helena-dem\xF4nio"
    actor: Mulher_idosa
    text: "O senhor n\xE3o precisa disso. Eu abro para o senhor."
    priority: P3
    direction: "Baixa, educada e fria; sem amea\xE7a gritante."
    voice: {fileID: 0}
  - id: wp_lockpick_helena_02
    trigger: helena
    character: "Helena-dem\xF4nio"
    actor: Mulher_idosa
    text: "N\xE3o precisa for\xE7ar. Pode deixar como est\xE1."
    priority: P3
    direction: "Baixa, educada e fria; sem amea\xE7a gritante."
    voice: {fileID: 0}
  - id: wp_lockpick_helena_03
    trigger: helena
    character: "Helena-dem\xF4nio"
    actor: Mulher_idosa
    text: Tem certeza de que quer abrir?
    priority: P3
    direction: "Baixa, educada e fria; sem amea\xE7a gritante."
    voice: {fileID: 0}
  - id: wp_lockpick_child_01
    trigger: child
    character: "Crian\xE7as"
    actor: Menina1
    text: Devagar.
    priority: P3
    direction: Muito baixo, curto e distante; sem gritar.
    voice: {fileID: 0}
  - id: wp_lockpick_child_02
    trigger: child
    character: "Crian\xE7as"
    actor: Menina1
    text: Aqui.
    priority: P3
    direction: Muito baixo, curto e distante; sem gritar.
    voice: {fileID: 0}
  - id: wp_lockpick_child_03
    trigger: child
    character: "Crian\xE7as"
    actor: Menina1
    text: "N\xE3o."
    priority: P3
    direction: Muito baixo, curto e distante; sem gritar.
    voice: {fileID: 0}
  - id: wp_lockpick_child_slow_01
    trigger: child.slow
    character: "Crian\xE7as"
    actor: Menina1
    text: Devagar.
    priority: P2
    direction: Muito baixo, curto e distante; sem gritar.
    voice: {fileID: 0}

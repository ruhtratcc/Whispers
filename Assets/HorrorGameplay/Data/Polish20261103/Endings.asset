  m_Name: Endings
  m_EditorClassIdentifier: HorrorGame.Runtime::HorrorGame.EndingPresentationConfig
  badCards:
  - "Amanheceu. A demoli\xE7\xE3o da SEEPE come\xE7ou \xE0s 8h."
  - "Ningu\xE9m encontrou as crian\xE7as."
  - "O que saiu da escola n\xE3o era a Helena."
  - "Jo\xE3o de Claus nunca mais foi visto."
  cardFadeSeconds: 0.45
  badSeconds: 4
  photoSeconds: 5
  creditsSeconds: 8
  goodPhoneLines:
  - speaker: "Jo\xE3o \u2014 telefone, 07:50"
    text: "Aqui \xE9 Jo\xE3o de Claus. Parem a demoli\xE7\xE3o. Chamem a pol\xEDcia. H\xE1 quatro crian\xE7as dentro da parede."
    seconds: 4
    voice: {fileID: 8300000, guid: 0b9b3d80ba711534cbc01496ab4037c5, type: 3}
    demonVoiceId: 
  - speaker: Atendente
    text: Vou avisar a equipe. Fique na linha, senhor.
    seconds: 2
    voice: {fileID: 8300000, guid: 0534c16acb33dff4daf13319f9549f7a, type: 3}
    demonVoiceId: 
  morningNews:
    speaker: "TV \u2014 notici\xE1rio"
    text: "Aten\xE7\xE3o, aten\xE7\xE3o. Aqui \xE9 o Jornal da Madrugada. Hoje, restos de quatro crian\xE7as desaparecidas h\xE1 vinte anos foram encontrados na antiga escola SEEPE. A pol\xEDcia j\xE1 est\xE1 no local."
    seconds: 8
    voice: {fileID: 8300000, guid: 1e91f624dc3d79a409824d0e4a0ee208, type: 3}
    demonVoiceId: 
  morningSeconds: 16
  eyeSeconds: 2
  replies:
  - Desculpa.
  - Obrigado.
  - Eu devia ter respondido.
  helenaReplies:
  - "Eu ouvi, seu Jo\xE3o."
  - Obrigada por responder.
  - "Pode descansar agora, seu Jo\xE3o."
  creditsText: "CR\xC9DITOS\n\nArthur de Araujo de Oliveira\nEduardo Borges Alfredo\nKahua Rodrigo Viana Cardoso\nAllan Victor Jungklaus da Silva\n\nFinal: N\xE3o confio em voc\xEA"

    sceneName: SchoolCEEP
    initialObjective: Examinar o espelho.
    completionPhrase: O que ficou no lugar ainda sabe seu nome.
    milestones:
    - id: bd.mirror.seen
      objectiveAfter: Continue olhando para o espelho.

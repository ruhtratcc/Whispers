    heading: "CAP\xCDTULO 3"
    sceneName: SchoolCEEP
    initialObjective: "Encontrar a secretaria. A porta est\xE1 aberta."
    completionPhrase: Ela nunca deixou de procurar.
    milestones:
    - id: bd.school.secretary
      objectiveAfter: "Examine as pegadas no ch\xE3o da secretaria."
      automaticSequenceId: 
      requiredItemIds: []
    - id: bd.school.cups
      objectiveAfter: Procure a lancheira na gaveta da secretaria.
      automaticSequenceId: 
      requiredItemIds: []

  sequences:
  - id: bd.four.intercom
    lockPlayer: 1
    completionSignal: 
    lines:
    - speaker: "Interfone \u2014 Helena"
      text: "Muito bem, Jo\xE3o. Agora o senhor j\xE1 sabe. Suba, por favor. \xC9 r\xE1pido. Eu preciso falar com o senhor."
      seconds: 11
      voice: {fileID: 8300000, guid: 25f74625d59d68940a27a1f06e060039, type: 3}
      demonVoiceId: 
    - speaker: "Jo\xE3o"
      text: "Ela sabe o que eu encontrei. Mas quem est\xE1 falando comigo?"
      seconds: 5
      voice: {fileID: 8300000, guid: fedf1489766963f42821ff931e454334, type: 3}
      demonVoiceId: 
  - id: bd.loop.voice
    lockPlayer: 0
    completionSignal: 
    lines:
    - speaker: "Helena, \xE0 frente"
      text: "Venha, Jo\xE3o. Est\xE1 quase."
      seconds: 4
      voice: {fileID: 0}
      demonVoiceId: demon_corridor_01
  - id: bd.loop.phone
    lockPlayer: 0
    completionSignal: 
    lines:
    - speaker: "Celular \u2014 Helena"
      text: "O senhor virou \xE0 esquerda. Eu preferiria que n\xE3o."
      seconds: 6
      voice: {fileID: 0}
      demonVoiceId: 
  - id: bd.mirror.offer
    lockPlayer: 1
    completionSignal: 
    lines:
    - speaker: Helena
      text: "Eles est\xE3o presos aqui por sua causa, Jo\xE3o. Algu\xE9m precisa ficar no lugar deles pra eles sa\xEDrem. O senhor sempre quis consertar isso."
      seconds: 10
      voice: {fileID: 0}
      demonVoiceId: demon_mirror_offer_01
    - speaker: "Jo\xE3o"
      text: Se eu ficar... eles saem.
      seconds: 4
      voice: {fileID: 8300000, guid: e5f701eecc9706949a7ca0c924cdc13c, type: 3}
      demonVoiceId: 
    - speaker: "Crian\xE7as"
      text: "n\xE3o"
      seconds: 2
      voice: {fileID: 8300000, guid: fada18d50aec9464f8e281d20997f22e, type: 3}
      demonVoiceId: 
  - id: bd.ending.refuse
    lockPlayer: 1
    completionSignal: 
    lines:
    - speaker: "Jo\xE3o"
      text: Meu Deus...
      seconds: 3
      voice: {fileID: 8300000, guid: 5809fd8f31c56244c91e0c35545a450a, type: 3}
      demonVoiceId: 
    - speaker: Helena
      text: "O senhor n\xE3o deveria ter feito isso."
      seconds: 5
      voice: {fileID: 0}
      demonVoiceId: demon_mirror_refuse_01
  - id: bd.ending.sign
    lockPlayer: 1
    completionSignal: 
    lines:
    - speaker: Helena
      text: "Obrigada, Jo\xE3o."
      seconds: 4
      voice: {fileID: 8300000, guid: 31781b05d5eca3048b9d6a4245d5e709, type: 3}
      demonVoiceId: 

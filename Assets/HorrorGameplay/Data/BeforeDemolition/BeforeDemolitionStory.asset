      automaticSequenceId: 
      requiredItemIds: []
    - id: bd.road.flashlight-taken
      objectiveAfter: Saia pela porta do motorista.
      automaticSequenceId: 
      requiredItemIds: []
    - id: bd.road.car-exited
      objectiveAfter: "Siga at\xE9 o port\xE3o da escola."
      automaticSequenceId: 
      requiredItemIds: []
    - id: bd.road.school-gate
      objectiveAfter: 
      automaticSequenceId: 
      requiredItemIds: []
  - id: bd.secretary-library

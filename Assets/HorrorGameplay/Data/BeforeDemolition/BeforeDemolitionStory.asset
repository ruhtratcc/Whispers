      objectiveAfter: Pegue a chave dentro da lancheira.
      automaticSequenceId: 
      requiredItemIds: []
    - id: bd.school.key
      objectiveAfter: Use a chave para entrar na biblioteca.
      automaticSequenceId: 
      requiredItemIds: []
    - id: bd.school.library
      objectiveAfter: "Examinar o mural da investiga\xE7\xE3o e pegar o relat\xF3rio no centro."

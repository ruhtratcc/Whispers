  - id: POLISH_20261103_ENDING_WARNING_02
    trigger: ending.warning
    speaker: "Crian\xE7as"
    priority: P0
    actor: "Crian\xE7as"
    text: "n\xE3o"
    direction: "Sussurros baixos, pr\xF3ximos e tristes, nunca agressivos."

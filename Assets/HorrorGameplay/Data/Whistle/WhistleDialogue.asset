    seconds: 2.5
  - id: POLISH_20261103_ENDING_WARNING_03
    trigger: ending.warning
    speaker: "Crian\xE7as"
    priority: P0
    actor: "Crian\xE7as"
    text: obrigado
    direction: "Sussurros baixos, pr\xF3ximos e tristes, nunca agressivos."

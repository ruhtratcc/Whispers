%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 20065ed1bc2cb5b49870c8142d99210a, type: 3}
  m_Name: WhistleDialogue
  m_EditorClassIdentifier: HorrorGame.Runtime::HorrorGame.WhistleDialogueCatalog
  lines:
  - id: wp_whistle_pickup_01
    trigger: pickup
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: O apito do Luan...
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 6bf2122dc3d719b428a841bb2b188c9f, type: 3}
    seconds: 2
  - id: wp_whistle_pickup_02
    trigger: pickup
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: "Ainda t\xE1 aqui."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: f3e1d6c69375a0d41af32342eb4f6a8d, type: 3}
    seconds: 2
  - id: wp_whistle_pickup_03
    trigger: pickup
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: Esse apito...
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 70080bcd66881b948ac8040b0aa25701, type: 3}
    seconds: 2
  - id: wp_whistle_pickup_04
    trigger: pickup
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: O apito tava aqui.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: c80407fc4833e4c48b2f216f781cfb00, type: 3}
    seconds: 2
  - id: wp_whistle_hesitate_01
    trigger: hesitate
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Faz tempo...
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: caf4668533d2aed499819a2263b2d6d8, type: 3}
    seconds: 2
  - id: wp_whistle_hesitate_02
    trigger: hesitate
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "S\xF3 um toque."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: d17397492140f2b4ab7be1d23794766d, type: 3}
    seconds: 2
  - id: wp_whistle_hesitate_03
    trigger: hesitate
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "T\xE1... vamos ver."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 36f1bc8bd2820bf4298cc25362730eb9, type: 3}
    seconds: 2
  - id: wp_whistle_hesitate_04
    trigger: hesitate
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "Calma. \xC9 s\xF3 soprar."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: ae29d6cdefb2bbc41874017e25ba50e0, type: 3}
    seconds: 2
  - id: wp_whistle_hint_1_01
    trigger: hint.1
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: Talvez o apito ajude.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 6fd102ab9070e784c9e2ee960828cb3b, type: 3}
    seconds: 2
  - id: wp_whistle_hint_1_02
    trigger: hint.1
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: E se eu usar o apito?
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 51a4c521eca288b4bb80d3705f4fab02, type: 3}
    seconds: 2
  - id: wp_whistle_hint_1_03
    trigger: hint.1
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: Posso tentar apitar aqui.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 3cd8f69a63423394a83b0df3106a8f10, type: 3}
    seconds: 2
  - id: wp_whistle_hint_1_04
    trigger: hint.1
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: Deixa eu ouvir o que volta.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: be5595af2fbcdbc46b9f39951b1254cf, type: 3}
    seconds: 2
  - id: wp_whistle_hint_2_01
    trigger: hint.2
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: Preciso escutar de onde vem a resposta.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 0}
    seconds: 2.4375
  - id: wp_whistle_hint_2_02
    trigger: hint.2
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: Talvez eu esteja olhando pro lado errado.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 0}
    seconds: 2.5625
  - id: wp_whistle_hint_2_03
    trigger: hint.2
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: "Melhor parar e prestar aten\xE7\xE3o."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 4ec80a281dd664743b6a694d568a1a11, type: 3}
    seconds: 2
  - id: wp_whistle_hint_2_04
    trigger: hint.2
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: O eco pode mostrar de onde veio.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 4063176348eac2b488dcbab381ce7767, type: 3}
    seconds: 2
  - id: wp_whistle_hint_3_01
    trigger: hint.3
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: "Um toque e depois sil\xEAncio."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 22b8fbb728e72f14fac9b8f0afdad74b, type: 3}
    seconds: 2
  - id: wp_whistle_hint_3_02
    trigger: hint.3
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: Preciso seguir o som, sem pressa.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 39674cd3b4a343c49bfe4db554fe830d, type: 3}
    seconds: 2.0625
  - id: wp_whistle_hint_3_03
    trigger: hint.3
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: Vou tentar olhando para os outros lados.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 95a5f040b3d42434da3dd62c60b1eb49, type: 3}
    seconds: 2.5
  - id: wp_whistle_hint_3_04
    trigger: hint.3
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: Preciso ouvir melhor.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 7254cd65a374f8745aeb3d8eb1da635d, type: 3}
    seconds: 2
  - id: wp_whistle_response_01
    trigger: response
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Veio dali.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 76c91a5274040be4996425b0275e550c, type: 3}
    seconds: 2
  - id: wp_whistle_response_02
    trigger: response
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Isso respondeu.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: dbd8ff33d703c8f4387e9ba52e7fab83, type: 3}
    seconds: 2
  - id: wp_whistle_response_03
    trigger: response
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Ouvi alguma coisa ali.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: af5c16f8f9a75a34f8ec15f5780a3a24, type: 3}
    seconds: 2
  - id: wp_whistle_response_04
    trigger: response
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Pera... daquele lado.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 67f6598b86a698e4bb108e4030850353, type: 3}
    seconds: 2
  - id: wp_whistle_nothing_01
    trigger: nothing
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Nada.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 82928a2783e3937408bf93581280b949, type: 3}
    seconds: 2
  - id: wp_whistle_nothing_02
    trigger: nothing
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "N\xE3o ouvi resposta."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: cab28573a7400e9499de5672ac1d52a7, type: 3}
    seconds: 2
  - id: wp_whistle_nothing_03
    trigger: nothing
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "Aqui n\xE3o."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 0ebf6d99d1bdaa145972cd90324c015a, type: 3}
    seconds: 2
  - id: wp_whistle_nothing_04
    trigger: nothing
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "S\xF3 o meu eco."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: f8101794d0d783c46ab92a60e3f03619, type: 3}
    seconds: 2
  - id: wp_whistle_correct_01
    trigger: correct
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Foi desse lado.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 59b82c8a81defd4428f21fe466e1d10d, type: 3}
    seconds: 2
  - id: wp_whistle_correct_02
    trigger: correct
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Aqui voltou mais perto.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: edb4898f86377194baddf81dfab9c46c, type: 3}
    seconds: 2
  - id: wp_whistle_correct_03
    trigger: correct
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "N\xE3o veio l\xE1 do fundo."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: aca8fb1e0461d8b4492af9244f4d404a, type: 3}
    seconds: 2
  - id: wp_whistle_correct_04
    trigger: correct
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: O som veio daqui.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 20a8b09845d6aff43a0da1953594ee59, type: 3}
    seconds: 2
  - id: wp_whistle_lost_01
    trigger: lost
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Sumiu no corredor.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 9aa5e5fee07347c4d9caeb95fd1024f1, type: 3}
    seconds: 2
  - id: wp_whistle_lost_02
    trigger: lost
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "N\xE3o voltou."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 529a1d0b9ccb120448b7c1a9af3bbbc9, type: 3}
    seconds: 2
  - id: wp_whistle_lost_03
    trigger: lost
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Esse eco se perdeu.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: f9d967eb3aeec0d43957a6e340830951, type: 3}
    seconds: 2
  - id: wp_whistle_lost_04
    trigger: lost
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Aqui o som vai embora.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 22cf10ada7affc547bb001d5c8d9f5f4, type: 3}
    seconds: 2
  - id: wp_whistle_exerted_01
    trigger: exerted
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Eu devia parar um pouco.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 2262d09c1fe5e1546a60d357e631eeed, type: 3}
    seconds: 2
  - id: wp_whistle_exerted_02
    trigger: exerted
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "Calma. N\xE3o precisa insistir."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: f91b994faebe44f43a5ddf2437366852, type: 3}
    seconds: 2
  - id: wp_whistle_exerted_03
    trigger: exerted
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: Vou respirar um pouco.
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: e8b1ed88eeced0949823a1b4d2e25333, type: 3}
    seconds: 2
  - id: wp_whistle_exerted_04
    trigger: exerted
    speaker: "Jo\xE3o"
    priority: P3
    actor: Homem1
    text: "J\xE1 soprei demais."
    direction: "Falar baixo e naturalmente, para si. Hesita\xE7\xE3o contida; sem anunciar a\xE7\xF5es como tutorial."
    voice: {fileID: 8300000, guid: 774b18efed2a73b4c8e8e3e108ece653, type: 3}
    seconds: 2
  - id: wp_whistle_helena_overuse_01
    trigger: helena.overuse
    speaker: Helena
    priority: P2
    actor: Mulher_idosa
    text: "O senhor n\xE3o precisa fazer isso."
    direction: "Polidez fria, baixa, sem amea\xE7a expl\xEDcita. Pausas curtas; n\xE3o imitar monstro."
    voice: {fileID: 8300000, guid: 194211cb63a1be94ab9976b03e43e305, type: 3}
    seconds: 2
  - id: wp_whistle_helena_overuse_02
    trigger: helena.overuse
    speaker: Helena
    priority: P2
    actor: Mulher_idosa
    text: "N\xE3o \xE9 preciso insistir, senhor Jo\xE3o."
    direction: "Polidez fria, baixa, sem amea\xE7a expl\xEDcita. Pausas curtas; n\xE3o imitar monstro."
    voice: {fileID: 8300000, guid: a370eab5c2963c940bf780ca937a624b, type: 3}
    seconds: 2.25
  - id: wp_whistle_helena_overuse_03
    trigger: helena.overuse
    speaker: Helena
    priority: P2
    actor: Mulher_idosa
    text: "Eu j\xE1 ouvi o senhor."
    direction: "Polidez fria, baixa, sem amea\xE7a expl\xEDcita. Pausas curtas; n\xE3o imitar monstro."
    voice: {fileID: 8300000, guid: d2b210888b5724d4a8b139a5953d1495, type: 3}
    seconds: 2
  - id: wp_whistle_helena_corridor_01
    trigger: helena.corridor
    speaker: Helena
    priority: P2
    actor: Mulher_idosa
    text: "Pode continuar, senhor Jo\xE3o."
    direction: "Polidez fria, baixa, sem amea\xE7a expl\xEDcita. Pausas curtas; n\xE3o imitar monstro."
    voice: {fileID: 8300000, guid: 97355ee3b6b7c4149996a14e24d330ae, type: 3}
    seconds: 2
  - id: wp_whistle_helena_corridor_02
    trigger: helena.corridor
    speaker: Helena
    priority: P2
    actor: Mulher_idosa
    text: "N\xE3o precisa fazer tanto esfor\xE7o."
    direction: "Polidez fria, baixa, sem amea\xE7a expl\xEDcita. Pausas curtas; n\xE3o imitar monstro."
    voice: {fileID: 8300000, guid: fa1fd7add2113064c836635a5ed5dc51, type: 3}
    seconds: 2
  - id: wp_whistle_helena_corridor_03
    trigger: helena.corridor
    speaker: Helena
    priority: P2
    actor: Mulher_idosa
    text: "Por aqui \xE9 mais simples."
    direction: "Polidez fria, baixa, sem amea\xE7a expl\xEDcita. Pausas curtas; n\xE3o imitar monstro."
    voice: {fileID: 8300000, guid: bf4c33055de17504f801431a6bd88bb5, type: 3}
    seconds: 2
  - id: wp_whistle_v2_plain_01
    trigger: plain
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: "S\xF3 um apito."
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: ccbd3edbe72af3d45b4d44378a2bb606, type: 3}
    seconds: 1
  - id: wp_whistle_v2_plain_02
    trigger: plain
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: "\xC9... s\xF3 o som mesmo."
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: d12fe30f4465e1545a16a5be1a1757c6, type: 3}
    seconds: 1.25
  - id: wp_whistle_v2_plain_03
    trigger: plain
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: "N\xE3o aconteceu nada."
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: 44b30fcb820949743bfd5204c231fa5e, type: 3}
    seconds: 1.1875
  - id: wp_whistle_v2_lore_01
    trigger: lore
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: "O apito... ser\xE1 que ainda funciona aqui?"
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: 091e7d1850219f44988eba704b86c5da, type: 3}
    seconds: 2.5
  - id: wp_whistle_v2_lore_02
    trigger: lore
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: Era assim que eles se encontravam...
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: 9e924b9f36f3d6c4a8dc83a61e24fab4, type: 3}
    seconds: 2.25
  - id: wp_whistle_v2_lore_03
    trigger: lore
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: "Talvez ainda d\xEA pra ouvir o sinal."
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: d0b7d74ee6f43594f87fcae0ae509396, type: 3}
    seconds: 2.125
  - id: wp_whistle_v2_discovered_01
    trigger: discovered
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: Elas... ainda respondem.
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: ca356fd4563070b4eb1319a6002a22e8, type: 3}
    seconds: 1.5
  - id: wp_whistle_v2_discovered_02
    trigger: discovered
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: Eu ouvi. Elas responderam.
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: cf890a5d0930bc94eb6e056455214e25, type: 3}
    seconds: 1.625
  - id: wp_whistle_v2_discovered_03
    trigger: discovered
    speaker: "Jo\xE3o"
    priority: P1
    actor: Homem1
    text: Ainda conseguem me ouvir...
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: b9597b3d9089cdc4f8a2d3bc677bd813, type: 3}
    seconds: 1.6875
  - id: wp_whistle_v2_cups_01
    trigger: cups
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: "As pegadas... est\xE3o aparecendo."
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: 4130eb088f856524bbabff2429627cfb, type: 3}
    seconds: 1.5625
  - id: wp_whistle_v2_cups_02
    trigger: cups
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: "O som est\xE1 mostrando as pegadas."
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: 88e66e67cf15cb34ebcbcc9357837d7f, type: 3}
    seconds: 1.8125
  - id: wp_whistle_v2_cups_03
    trigger: cups
    speaker: "Jo\xE3o"
    priority: P2
    actor: Homem1
    text: "As pegadas seguem at\xE9 a escada."
    direction: "Baixo, contido, como quem percebe algo sozinho. Deixar o sil\xEAncio entre as frases."
    voice: {fileID: 8300000, guid: 1c77e27f958d5de47913bc06c2c5c8f5, type: 3}
    seconds: 2.1875
  - id: wp_whistle_v2_child_call_01
    trigger: child.call
    speaker: "Crian\xE7a"
    priority: P1
    actor: Menina1
    text: o apito
    direction: "Baix\xEDssimo, perto do ouvido mas com dire\xE7\xE3o no espa\xE7o; voz humana, sem efeito monstruoso."
    voice: {fileID: 8300000, guid: 7aa2678dd1408094292807e3661b90aa, type: 3}
    seconds: 1

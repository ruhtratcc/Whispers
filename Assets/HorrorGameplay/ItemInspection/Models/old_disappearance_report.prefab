  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "RELAT\xD3RIO INTERNO\n\nARQUIVO DE OCORR\xCANCIAS \u2014 C\xD3PIA INTERNA\n\nNa noite dos desaparecimentos, a chamada foi interrompida. As p\xE1ginas seguintes foram arrancadas.\n\nEntre os nomes ainda leg\xEDveis: Jo\xE3o de Claus. Uma anota\xE7\xE3o a l\xE1pis pede que a fotografia seja devolvida \xE0 Sala de apoio aos alunos.\n\nA chave do arquivo foi guardada no Dep\xF3sito t\xE9cnico, no fim deste corredor. A porta do arquivo fica na antiga Inform\xE1tica B.\n\nAlgu\xE9m escreveu na margem: n\xE3o apague meu nome."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
